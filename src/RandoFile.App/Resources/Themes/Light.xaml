<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Brush.Window" Color="#F2F4F8" />
    <SolidColorBrush x:Key="Brush.Header" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Card" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.CardBorder" Color="#E3E8F0" />
    <SolidColorBrush x:Key="Brush.Divider" Color="#EAEEF5" />

    <!-- Text -->
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#101725" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#6B7A90" />
    <SolidColorBrush x:Key="Brush.TextOnAccent" Color="#FFFFFF" />

    <!-- Accent -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#2F6BFF" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#1F5AF0" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#1748C6" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#E8EFFF" />

    <!-- Controls -->
    <SolidColorBrush x:Key="Brush.Control" Color="#F7F9FC" />
    <SolidColorBrush x:Key="Brush.ControlHover" Color="#EEF3FB" />
    <SolidColorBrush x:Key="Brush.ControlBorder" Color="#D9E0EB" />
    <SolidColorBrush x:Key="Brush.ControlDisabled" Color="#F1F3F7" />
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="#A5AFBF" />

    <!-- States -->
    <SolidColorBrush x:Key="Brush.Success" Color="#128A4B" />
    <SolidColorBrush x:Key="Brush.SuccessSoft" Color="#E4F6EC" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#D33B3B" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#FDEBEB" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#B87A00" />
    <SolidColorBrush x:Key="Brush.WarningSoft" Color="#FDF3DF" />
    <SolidColorBrush x:Key="Brush.Info" Color="#2F6BFF" />
    <SolidColorBrush x:Key="Brush.InfoSoft" Color="#E8EFFF" />

    <!-- Lists -->
    <SolidColorBrush x:Key="Brush.Row" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.RowAlt" Color="#FAFBFD" />
    <SolidColorBrush x:Key="Brush.RowHover" Color="#EFF4FF" />
    <SolidColorBrush x:Key="Brush.Selection" Color="#DDE7FF" />

</ResourceDictionary>
