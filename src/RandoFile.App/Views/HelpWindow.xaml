<Window x:Class="RandoFile.App.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Help.Title}"
        Icon="pack://application:,,,/Assets/Brand/logo-mark.png"
        Width="980"
        Height="700"
        MinWidth="780"
        MinHeight="520"
        Background="{DynamicResource Brush.Window}"
        FontFamily="{StaticResource App.FontFamily}"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= Header ================= -->
        <Border Grid.Row="0"
                Background="{DynamicResource Brush.Header}"
                BorderBrush="{DynamicResource Brush.Divider}"
                BorderThickness="0,0,0,1"
                Padding="20,16">
            <StackPanel>
                <TextBlock Text="{DynamicResource Help.Title}" Style="{StaticResource TitleText}" />
                <TextBlock Text="{DynamicResource Help.Subtitle}"
                           Style="{StaticResource CaptionText}"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- ================= Body ================= -->
        <TabControl Grid.Row="1"
                    Margin="16"
                    Background="Transparent"
                    BorderThickness="0"
                    TabStripPlacement="Left">

            <!-- Getting started -->
            <TabItem Style="{StaticResource HelpTabItem}">
                <TabItem.Header>
                    <TextBlock Text="{DynamicResource Help.Tab.Start}"
                               TextWrapping="Wrap"
                               TextAlignment="Left" />
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8,0,0,0">

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="300" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ContentControl Grid.Column="0" ContentTemplate="{StaticResource Mockup.Browse}" />
                                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Help.Step1.Title}"
                                               Style="{StaticResource WindowTitle}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{DynamicResource Help.Step1.Body}"
                                               Style="{StaticResource BodyText}"
                                               Margin="0,8,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="300" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ContentControl Grid.Column="0" ContentTemplate="{StaticResource Mockup.Pattern}" />
                                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Help.Step2.Title}"
                                               Style="{StaticResource WindowTitle}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{DynamicResource Help.Step2.Body}"
                                               Style="{StaticResource BodyText}"
                                               Margin="0,8,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="300" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ContentControl Grid.Column="0" ContentTemplate="{StaticResource Mockup.Preview}" />
                                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Help.Step3.Title}"
                                               Style="{StaticResource WindowTitle}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{DynamicResource Help.Step3.Body}"
                                               Style="{StaticResource BodyText}"
                                               Margin="0,8,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource Brush.InfoSoft}"
                                CornerRadius="10"
                                Padding="12,9"
                                Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F4A1;"
                                           FontSize="14"
                                           VerticalAlignment="Top"
                                           Margin="0,1,10,0" />
                                <TextBlock Text="{DynamicResource Help.Tip.Preview}"
                                           Style="{StaticResource BodyText}"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,0" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="300" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ContentControl Grid.Column="0" ContentTemplate="{StaticResource Mockup.Actions}" />
                                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Help.Step4.Title}"
                                               Style="{StaticResource WindowTitle}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{DynamicResource Help.Step4.Body}"
                                               Style="{StaticResource BodyText}"
                                               Margin="0,8,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Naming pattern -->
            <TabItem Style="{StaticResource HelpTabItem}">
                <TabItem.Header>
                    <TextBlock Text="{DynamicResource Help.Tab.Naming}"
                               TextWrapping="Wrap"
                               TextAlignment="Left" />
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8,0,0,0">

                        <ContentControl ContentTemplate="{StaticResource Mockup.Rename}"
                                        HorizontalAlignment="Left"
                                        MaxWidth="420" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="{DynamicResource Help.Naming.Presets.Title}" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{DynamicResource Help.Naming.Presets.Body}" Style="{StaticResource BodyText}" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="{DynamicResource Help.Naming.Prefix.Title}" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{DynamicResource Help.Naming.Prefix.Body}" Style="{StaticResource BodyText}" />
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="0">
                                <TextBlock Text="{DynamicResource Help.Naming.Numbering.Title}" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{DynamicResource Help.Naming.Numbering.Body}" Style="{StaticResource BodyText}" />
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="2">
                                <TextBlock Text="{DynamicResource Help.Naming.Extension.Title}" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{DynamicResource Help.Naming.Extension.Body}" Style="{StaticResource BodyText}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Shortcuts and safety -->
            <TabItem Style="{StaticResource HelpTabItem}">
                <TabItem.Header>
                    <TextBlock Text="{DynamicResource Help.Tab.Safety}"
                               TextWrapping="Wrap"
                               TextAlignment="Left" />
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8,0,0,0">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <ContentControl ContentTemplate="{StaticResource Mockup.Actions}" />
                                <ContentControl ContentTemplate="{StaticResource Mockup.Undo}" Margin="0,12,0,0" />
                            </StackPanel>

                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Help.ShortcutsTitle}" Style="{StaticResource SectionTitle}" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource KeyCap}">
                                            <TextBlock Text="F1"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.TextPrimary}" />
                                        </Border>
                                        <TextBlock Grid.Column="1"
                                                   Text="{DynamicResource Help.Key.F1}"
                                                   Style="{StaticResource CaptionText}"
                                                   Margin="12,4,0,0" />
                                    </Grid>

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource KeyCap}">
                                            <TextBlock Text="Enter"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.TextPrimary}" />
                                        </Border>
                                        <TextBlock Grid.Column="1"
                                                   Text="{DynamicResource Help.Key.Enter}"
                                                   Style="{StaticResource CaptionText}"
                                                   Margin="12,4,0,0" />
                                    </Grid>

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource KeyCap}">
                                            <TextBlock Text="Tab"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.TextPrimary}" />
                                        </Border>
                                        <TextBlock Grid.Column="1"
                                                   Text="{DynamicResource Help.Key.Tab}"
                                                   Style="{StaticResource CaptionText}"
                                                   Margin="12,4,0,0" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="{DynamicResource Help.Safety.Atomic.Title}" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{DynamicResource Help.Safety.Atomic.Body}" Style="{StaticResource BodyText}" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="{DynamicResource Help.Safety.NoOverwrite.Title}" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{DynamicResource Help.Safety.NoOverwrite.Body}" Style="{StaticResource BodyText}" />
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="0">
                                <TextBlock Text="{DynamicResource Help.Safety.Temp.Title}" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{DynamicResource Help.Safety.Temp.Body}" Style="{StaticResource BodyText}" />
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="2">
                                <TextBlock Text="{DynamicResource Help.Safety.Undo.Title}" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{DynamicResource Help.Safety.Undo.Body}" Style="{StaticResource BodyText}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- FAQ -->
            <TabItem Style="{StaticResource HelpTabItem}">
                <TabItem.Header>
                    <TextBlock Text="{DynamicResource Help.Tab.Faq}"
                               TextWrapping="Wrap"
                               TextAlignment="Left" />
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8,0,0,0">

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Help.Faq1.Q}"
                                           Style="{StaticResource WindowTitle}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{DynamicResource Help.Faq1.A}"
                                           Style="{StaticResource BodyText}"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Help.Faq2.Q}"
                                           Style="{StaticResource WindowTitle}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{DynamicResource Help.Faq2.A}"
                                           Style="{StaticResource BodyText}"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Help.Faq3.Q}"
                                           Style="{StaticResource WindowTitle}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{DynamicResource Help.Faq3.A}"
                                           Style="{StaticResource BodyText}"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ================= Footer ================= -->
        <Border Grid.Row="2"
                Background="{DynamicResource Brush.Header}"
                BorderBrush="{DynamicResource Brush.Divider}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1"
                        Content="{DynamicResource Actions.Close}"
                        Click="OnCloseClick"
                        Style="{StaticResource PrimaryButton}" />
            </Grid>
        </Border>
    </Grid>
</Window>
