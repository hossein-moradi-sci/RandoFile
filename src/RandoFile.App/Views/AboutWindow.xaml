<Window x:Class="RandoFile.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:RandoFile.Core;assembly=RandoFile.Core"
        Title="{DynamicResource About.Title}"
        Icon="pack://application:,,,/Assets/Brand/logo-mark.png"
        Width="540"
        Height="620"
        MinWidth="460"
        MinHeight="520"
        Background="{DynamicResource Brush.Window}"
        FontFamily="{StaticResource App.FontFamily}"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource Brush.Header}"
                BorderBrush="{DynamicResource Brush.Divider}"
                BorderThickness="0,0,0,1"
                Padding="20,16">
            <TextBlock Text="{DynamicResource About.Title}" Style="{StaticResource TitleText}" />
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20">

                <!-- Identity -->
                <Border Style="{StaticResource Card}" Padding="20">
                    <StackPanel>
                        <Image Source="pack://application:,,,/Assets/Brand/logo-mark.png"
                               Width="72"
                               Height="72"
                               HorizontalAlignment="Center" />

                        <TextBlock Text="{x:Static core:AppInfo.Brand}"
                                   Style="{StaticResource TitleText}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Margin="0,14,0,0" />
                        <TextBlock Text="{x:Static core:AppInfo.DisplayVersion}"
                                   Style="{StaticResource CaptionText}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0" />
                        <TextBlock Text="{x:Static core:AppInfo.Name}"
                                   Style="{StaticResource BodyText}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Margin="0,16,0,0" />
                        <TextBlock Text="{x:Static core:AppInfo.Tagline}"
                                   Style="{StaticResource CaptionText}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Margin="0,4,0,0"
                                   MaxWidth="380" />
                    </StackPanel>
                </Border>

                <!-- Creator -->
                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="{DynamicResource About.Creator}"
                                   Style="{StaticResource CaptionText}"
                                   Margin="0,0,16,12" />
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{x:Static core:AppInfo.Creator}"
                                   Style="{StaticResource BodyText}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12" />

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="{DynamicResource About.Profession}"
                                   Style="{StaticResource CaptionText}"
                                   Margin="0,0,16,12" />
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="{DynamicResource About.ProfessionValue}"
                                   Style="{StaticResource BodyText}"
                                   Margin="0,0,0,12" />

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="{DynamicResource About.Field}"
                                   Style="{StaticResource CaptionText}"
                                   Margin="0,0,16,12" />
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   Text="{DynamicResource About.FieldValue}"
                                   Style="{StaticResource BodyText}"
                                   Margin="0,0,0,12" />

                        <TextBlock Grid.Row="3" Grid.Column="0"
                                   Text="{DynamicResource About.Version}"
                                   Style="{StaticResource CaptionText}"
                                   Margin="0,0,16,12" />
                        <TextBlock Grid.Row="3" Grid.Column="1"
                                   Text="{x:Static core:AppInfo.DisplayVersion}"
                                   Style="{StaticResource BodyText}"
                                   Margin="0,0,0,12" />

                        <TextBlock Grid.Row="4" Grid.Column="0"
                                   Text="{DynamicResource About.Repository}"
                                   Style="{StaticResource CaptionText}"
                                   Margin="0,0,16,0" />
                        <TextBlock Grid.Row="4" Grid.Column="1"
                                   Text="{x:Static core:AppInfo.RepositoryUrl}"
                                   Style="{StaticResource BodyText}"
                                   TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <TextBlock x:Name="CopyrightText"
                           Style="{StaticResource CaptionText}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,16,0,0" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="{DynamicResource Brush.Header}"
                BorderBrush="{DynamicResource Brush.Divider}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="UpdateStatusText"
                               Style="{StaticResource CaptionText}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="CheckUpdatesButton"
                            Content="{DynamicResource Actions.CheckNow}"
                            Click="OnCheckUpdatesClick"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0" />
                    <Button Content="{DynamicResource Actions.Close}"
                            Click="OnCloseClick"
                            Style="{StaticResource PrimaryButton}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
