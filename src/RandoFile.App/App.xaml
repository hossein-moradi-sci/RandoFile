<Application x:Class="RandoFile.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Swapped at runtime by ThemeService. -->
                <ResourceDictionary Source="Resources/Themes/Light.xaml" />
                <ResourceDictionary Source="Resources/Themes/Controls.xaml" />
                <!-- Vector mock-ups used by the help window. -->
                <ResourceDictionary Source="Resources/Help/Mockups.xaml" />
                <!-- Swapped at runtime by LocalizationService. -->
                <ResourceDictionary Source="Resources/Strings/Strings.en.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
