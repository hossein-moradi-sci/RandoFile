<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>RandoFile</AssemblyName>
    <RootNamespace>RandoFile.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Brand\randofile.ico</ApplicationIcon>
    <!-- Explicit usings on purpose: WPF's implicit usings import System.Windows.Shapes,
         whose Path type collides with System.IO.Path. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RandoFile.Core\RandoFile.Core.csproj" />
  </ItemGroup>

  <!--
    Brand assets, generated by tools/Generate-Logo.ps1. Only the transparent mark is embedded:
    the XAML loads it with a pack URI, and randofile.ico is consumed by ApplicationIcon above.
    logo.png stays on disk as the master image used by the README.
  -->
  <ItemGroup>
    <Resource Include="Assets\Brand\logo-mark.png" />
  </ItemGroup>

</Project>
