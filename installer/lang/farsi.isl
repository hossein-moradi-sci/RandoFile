; Inno Setup - Persian wizard strings for RandoFile.
; RightToLeft=yes mirrors the wizard controls and reverses text alignment.
; Save this file as UTF-8 with a byte order mark, otherwise the compiler reads
; it as ANSI and the Persian text is mangled.

[LangOptions]
LanguageName=فارسی
LanguageID=$0429
LanguageCodePage=1256
RightToLeft=yes
DialogFontName=Segoe UI
DialogFontSize=9
DialogFontBaseScaleWidth=7
DialogFontBaseScaleHeight=15
WelcomeFontName=Segoe UI
WelcomeFontSize=14

